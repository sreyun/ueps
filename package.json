{
	"name": "ps-platform",
	"version": "1.3.1",
	"private": true,
	"description": "UE 像素流云渲染管理平台：信令 + 实例调度 + 管理端 + 内置 TURN/TCP 中继（经 nginx 单端口对外，零 UDP 映射）",
	"main": "server.js",
	"bin": {
		"ps-platform": "server.js"
	},
	"scripts": {
		"start": "node server.js",
		"agent": "node server.js --agent",
		"turn": "node server.js --turn",
		"test": "node --test --test-timeout=120000 \"test/*.test.js\"",
		"load": "node test/load/platform-load.js",
		"build:exe": "node build/build-exe.js"
	},
	"dependencies": {
		"ws": "^8.18.0"
	},
	"engines": {
		"node": ">=22.13"
	},
	"license": "UNLICENSED",
	"devDependencies": {
		"esbuild": "^0.25.0"
	}
}
