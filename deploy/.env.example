# ps-platform docker-compose 配置。复制为 .env 后修改：cp .env.example .env
# 生成随机密钥：openssl rand -hex 24

# 说明：网段、可信代理、UE 地址、日志、内置 TURN 端口等参数现在在管理端「系统设置 → 系统参数」中维护（保存在数据库，随备份导出）。
# 下面这些项只有在填写时才会传给平台，并以填写的值为准、管理端只读（兼容旧部署）；删除后沿用当时的值，改由管理端维护。
# 运行 docker compose exec platform node server.js --show-config 可查看每个参数的生效值与来源。

# ---- 密钥（留空则首次启动随机生成并保存在 data/ 数据库中）-------------------------
# 初始管理员口令（只在首次启动、数据库里还没有用户时生效；留空则随机生成到 data/initial-admin.txt）
PS_ADMIN_PASSWORD=
# 渲染机 Agent 连接令牌（演示叠加文件要求必填）
PS_AGENT_TOKEN=
# 内置 TURN 共享密钥
TURN_SECRET=

# ---- 网络（可选；建议留空，在管理端维护）---------------------------------------------
# 网关本机内网 IP（内置 TURN 中继地址，UE 渲染机必须能访问）。留空 = 自动取第一个内网 IP；多网卡时填写
# LAN_IP=192.168.1.10
# UE 渲染机所在网段：只允许这些地址以 UE/Agent 身份连接平台、只允许 TURN 中继到这些地址（本机回环地址始终允许）
# UE_SUBNETS=192.168.1.0/24
# 允许访问管理端 / API / metrics 的网段
# ADMIN_SUBNETS=127.0.0.0/8,192.168.1.0/24
# 网关前面还有一层 HTTP 反向代理时（路由器的反向代理 / 云负载均衡 / CDN），填它连到网关时的源地址，
# 平台才能从 X-Forwarded-For 取到观众真实 IP（否则所有外网观众都显示为该代理的地址）。注意：此时 TURN 不能经过该反代，见 INSTALL.md 8.1
# UPSTREAM_PROXIES=192.168.1.1
# 额外视为"内网"的网段（专线/VPN 分支机构），这些用户不会被当作外网用户
# LAN_NETWORKS=10.20.0.0/16
# UE 连接平台使用的地址（默认 auto：Agent 连接平台时使用的地址）
# PS_UE_HOST=192.168.1.10:88
# 日志级别 debug / info / warn / error
# PS_LOG_LEVEL=info

# ---- 端口（可选；与其它服务共用一台机器时修改）------------------------------------
# 管理口（管理端 / UE / Agent，仅内网）
# PS_PORT=88
# 观众口（只监听 127.0.0.1，仅 nginx 访问）
# PS_PUBLIC_PORT=8088
# 内置 TURN 的 TCP 监听端口（127.0.0.1，仅 nginx 访问）
# TURN_PORT=3478
# 中继 UDP 端口范围（只在内网使用，无需映射）：容量 ≈ 端口数 / 2。也可在管理端维护
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=50159
# nginx 对外端口（https/wss + TURN 多路复用）与 http 跳转端口
# MUX_PORT=443
# HTTP_PORT=80
# nginx 内部端口（127.0.0.1）与状态口
# INT_HTTPS=127.0.0.1:8443
# INT_TURNS=127.0.0.1:5349
# INT_TURN=127.0.0.1:3479
# INT_HTTP=127.0.0.1:3480        # 同端口明文 http 的内部入口（TURN 识别出 HTTP 请求后转到这里）
# STATUS_ADDR=127.0.0.1:9180

# ---- TURN 策略（首次启动写入，之后以管理端「系统设置 → 播放链路」为准）-----------------
# 强制只走 TURN：false（默认，ICE 自动择优）/ external（仅外网观众）/ true（所有人）
# TURN_FORCE_RELAY=false
# TURN worker 进程数：auto = min(4, CPU 核数)。也可在管理端「系统参数」维护
# TURN_WORKERS=auto
# 自建数据中心 STUN/TURN（coturn use-auth-secret）
# DC_TURN_URLS=stun:turn.your-dc.com:3478,turn:turn.your-dc.com:3478?transport=udp,turns:turn.your-dc.com:443?transport=tcp
# DC_TURN_SECRET=same-as-coturn-static-auth-secret

# ---- 其它 -------------------------------------------------------------------
# 数据目录（数据库、日志、自定义网页）
# DATA_DIR=./data
# 证书目录（fullchain.pem / privkey.pem）
# CERT_DIR=./certs
# 平台镜像：默认本地构建 ps-platform:<版本>。改用预构建镜像（华为云 SWR，免去本地构建）：
#   PS_IMAGE=swr.cn-east-3.myhuaweicloud.com/sreyun/ps-platform:1.5.0
#   docker compose pull platform && docker compose up -d --no-build
# PS_IMAGE=
# 镜像源（国内网络拉不到 Docker Hub 时）
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:stable-alpine
# APK_MIRROR=https://mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com
